{
  "name": "terra-qa",
  "private": true,
  "scripts": {
    "dev": "vite",
    "pretest": "node scripts/build-site.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:report": "playwright show-report",
    "build": "node scripts/build-site.cjs",
    "deploy": "node scripts/build-site.cjs && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "qrcode-generator": "^2.0.4",
    "supabase": "^2.117.0",
    "vite": "8.2.2",
    "wrangler": "^4"
  }
}
